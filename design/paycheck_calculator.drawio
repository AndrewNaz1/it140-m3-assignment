<mxfile host="65bd71144e">
    <diagram id="paycheck-calculator-page" name="Paycheck Calculator">
        <mxGraphModel dx="668" dy="608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="Paycheck Calculator-title" value="&lt;h2&gt;Paycheck Calculator Flowchart&lt;/h2&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;" parent="1" vertex="1">
                    <mxGeometry x="220" y="20" width="410" height="50" as="geometry"/>
                </mxCell>

                <!-- Start terminator -->
                <mxCell id="start" value="START" style="strokeWidth=2;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="375" y="90" width="100" height="50" as="geometry"/>
                </mxCell>

                <!-- Input: hours worked -->
                <mxCell id="input-hours" value="GET hoursWorked" style="shape=parallelogram;perimeter=parallelogramPerimeter;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=13;align=center;" parent="1" vertex="1">
                    <mxGeometry x="340" y="180" width="170" height="60" as="geometry"/>
                </mxCell>

                <!-- Processing: set constant rates -->
                <mxCell id="set-rates" value="LET regularRate = 20&lt;br&gt;LET overtimeRate = 30&lt;br&gt;LET regularHours = 40" style="rounded=1;arcSize=14;absoluteArcSize=1;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=13;align=center;" parent="1" vertex="1">
                    <mxGeometry x="330" y="280" width="190" height="80" as="geometry"/>
                </mxCell>

                <!-- Decision: overtime? -->
                <mxCell id="decision-overtime" value="&lt;b&gt;hoursWorked&lt;/b&gt;&lt;br&gt;&amp;gt; regularHours?" style="strokeWidth=2;shape=mxgraph.flowchart.decision;whiteSpace=wrap;html=1;fontSize=12;aspect=fixed;" parent="1" vertex="1">
                    <mxGeometry x="340" y="410" width="170" height="120" as="geometry"/>
                </mxCell>

                <!-- True branch: overtime processing -->
                <mxCell id="true-overtime" value="LET overtimeHours =&lt;br&gt;hoursWorked - regularHours&lt;br&gt;&lt;br&gt;LET overtimePay =&lt;br&gt;overtimeHours * overtimeRate" style="rounded=1;arcSize=14;absoluteArcSize=1;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;align=center;" parent="1" vertex="1">
                    <mxGeometry x="80" y="590" width="200" height="120" as="geometry"/>
                </mxCell>

                <!-- False branch: regular pay only -->
                <mxCell id="false-regular" value="LET overtimeHours = 0&lt;br&gt;&lt;br&gt;LET overtimePay = 0" style="rounded=1;arcSize=14;absoluteArcSize=1;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;align=center;" parent="1" vertex="1">
                    <mxGeometry x="570" y="590" width="200" height="120" as="geometry"/>
                </mxCell>

                <!-- Merge: compute regular pay and total (common to both paths) -->
                <mxCell id="merge" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="410" y="775" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="calc-total" value="LET regularPay = regularHours * regularRate&lt;br&gt;&lt;br&gt;LET weeklyPaycheck =&lt;br&gt;regularPay + overtimePay" style="rounded=1;arcSize=14;absoluteArcSize=1;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;align=center;" parent="1" vertex="1">
                    <mxGeometry x="325" y="830" width="200" height="110" as="geometry"/>
                </mxCell>

                <!-- Output -->
                <mxCell id="output" value="PUT weeklyPaycheck" style="shape=parallelogram;perimeter=parallelogramPerimeter;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=13;align=center;" parent="1" vertex="1">
                    <mxGeometry x="340" y="970" width="170" height="60" as="geometry"/>
                </mxCell>

                <!-- End terminator -->
                <mxCell id="end" value="END" style="strokeWidth=2;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="375" y="1060" width="100" height="50" as="geometry"/>
                </mxCell>

                <!-- Edges -->
                <mxCell id="edge-start-input" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;" parent="1" edge="1" source="start" target="input-hours">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge-input-rates" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;" parent="1" edge="1" source="input-hours" target="set-rates">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge-rates-decision" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;" parent="1" edge="1" source="set-rates" target="decision-overtime">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Decision True (left) -->
                <mxCell id="edge-true" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;" parent="1" edge="1" source="decision-overtime" target="true-overtime">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="label-true" value="TRUE" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;" parent="edge-true" vertex="1" connectable="0">
                    <mxGeometry x="-0.1" relative="1" as="geometry">
                        <mxPoint x="-6" y="-12" as="offset"/>
                    </mxGeometry>
                </mxCell>

                <!-- Decision False (right) -->
                <mxCell id="edge-false" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;" parent="1" edge="1" source="decision-overtime" target="false-regular">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="label-false" value="FALSE" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;" parent="edge-false" vertex="1" connectable="0">
                    <mxGeometry x="-0.1" relative="1" as="geometry">
                        <mxPoint x="6" y="-12" as="offset"/>
                    </mxGeometry>
                </mxCell>

                <!-- Both branches converge on the merge point -->
                <mxCell id="edge-true-merge" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;" parent="1" edge="1" source="true-overtime" target="merge">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge-false-merge" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;" parent="1" edge="1" source="false-regular" target="merge">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <mxCell id="edge-merge-total" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;" parent="1" edge="1" source="merge" target="calc-total">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge-total-output" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;" parent="1" edge="1" source="calc-total" target="output">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge-output-end" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;" parent="1" edge="1" source="output" target="end">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>

    <diagram name="README" id="paycheck-readme-page">
        <mxGraphModel dx="668" dy="1708" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="README-title" value="&lt;h2&gt;How to Use This Flowchart Template&lt;/h2&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;" parent="1" vertex="1">
                    <mxGeometry x="160" y="30" width="530" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="readme-body" value="&lt;b&gt;1. Read the Module Three Assignment Guidelines and Rubric first.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Complete Analyze before designing.&lt;/b&gt; Make sure you understand the input, pay rules, 40-hour boundary, decision, and output.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Build the graded chart on the Paycheck Calculator tab.&lt;/b&gt; Do not submit the README, Symbols, Snippets, or References tabs separately; they remain inside this .drawio file as reference pages.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Use appropriate symbols and arrows.&lt;/b&gt; The official assignment specifically calls for Start/End, Input/Output, Decision, and Processing symbols.&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Check every path.&lt;/b&gt; Trace a regular-hours case, exactly 40 hours, an overtime case, and the 60-hour assignment example. Every path should reach the required output and End.&lt;br&gt;&lt;br&gt;&lt;b&gt;6. Compare with your pseudocode.&lt;/b&gt; Both graded artifacts should describe the same planned program.&lt;br&gt;&lt;br&gt;&lt;b&gt;7. Keep the file in .drawio format.&lt;/b&gt; Save frequently. Do not export an image or PDF as a replacement for the required .drawio submission." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;strokeWidth=1;spacing=14;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="100" y="120" width="650" height="500" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>

    <diagram name="References" id="paycheck-references-page">
        <mxGraphModel dx="668" dy="608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="ref-title" value="&lt;h2&gt;References&lt;/h2&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;" parent="1" vertex="1">
                    <mxGeometry x="160" y="30" width="530" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="ref-body" value="IT 140 Module Three Assignment: Design a Paycheck Calculator (assignment prompt and pay rules).&lt;br&gt;&lt;br&gt;Module Three flowchart symbols reference, IT-140 Flowchart Template, Symbols tab.&lt;br&gt;&lt;br&gt;Module Three pseudocode keyword reference (GET, PUT, LET, IF, ELSE, ENDIF).&lt;br&gt;&lt;br&gt;This design follows the assignment's stated pay rules: $20 per hour for the first 40 hours worked, and $30 per hour (overtime rate) for each hour worked above 40. The example given in the prompt (60 hours) is used to check the overtime path." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;strokeWidth=1;spacing=14;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="100" y="120" width="650" height="420" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>

